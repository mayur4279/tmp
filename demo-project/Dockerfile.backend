FROM golang:1.19-alpine AS backend-builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN go build -o main .

FROM alpine:latest

RUN apk update && apk add --no-cache \
    postgresql15 \
    postgresql15-client \
    postgresql15-contrib \
    ca-certificates \
    su-exec \
    curl

WORKDIR /app
RUN mkdir -p /var/lib/postgresql/data && \
    chown -R postgres:postgres /var/lib/postgresql && \
    mkdir -p /run/postgresql && \
    chown -R postgres:postgres /run/postgresql

COPY --from=backend-builder /app/main /app/main

COPY init-db.sh /app/init-db.sh
COPY startup.sh /app/startup.sh
RUN chmod +x /app/init-db.sh /app/startup.sh

EXPOSE 8080 5432

ENV DB_HOST=localhost
ENV DB_USER=postgres
ENV DB_PASSWORD=password
ENV DB_NAME=employee_management
ENV DB_PORT=5432
ENV ALLOWED_ORIGINS=*
ENV PGDATA=/var/lib/postgresql/data


HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD pg_isready -U postgres -d employee_management && curl -f http://localhost:8080/health || exit 1

# Use the startup script
CMD ["/app/startup.sh"]